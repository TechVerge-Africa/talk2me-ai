# ─── Supabase ───────────────────────────────────────────────────────
# Get these from your Supabase project > Settings > API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here

# Keep these server-side only — never expose in the browser
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_DB_PASSWORD=your_database_password_here
SUPABASE_PROJECT_ID=your_project_id_here
SUPABASE_ACCESS_TOKEN=your_supabase_access_token_here

# ─── LiveKit ────────────────────────────────────────────────────────
# Get these from your LiveKit Cloud project settings
LIVEKIT_URL=wss://your-project.livekit.cloud
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your_livekit_api_key
LIVEKIT_API_SECRET=your_livekit_api_secret

# ─── Cron & Internal ─────────────────────────────────────────────────
# Generate a strong random secret: openssl rand -hex 32
# Add this same value to Vercel Environment Variables
CRON_SECRET=your_cron_secret_here

# ─── Speech-to-Text / AI Captioning ─────────────────────────────────
# Get your free key from https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

